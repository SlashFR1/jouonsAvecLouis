# Configuration Neon PostgreSQL
# Obtenez votre URL de connexion sur https://neon.tech
DATABASE_URL="postgresql://user:password@ep-xyz.eu-central-1.aws.neon.tech/belote?sslmode=require"

# Configuration Pusher Channels (Temps Réel Vercel)
# Créez une application gratuite sur https://pusher.com
PUSHER_APP_ID="votre_app_id"
PUSHER_KEY="votre_key"
PUSHER_SECRET="votre_secret"
PUSHER_CLUSTER="eu"

# Variables publiques accessibles côté navigateur
NEXT_PUBLIC_PUSHER_KEY="votre_key"
NEXT_PUBLIC_PUSHER_CLUSTER="eu"
